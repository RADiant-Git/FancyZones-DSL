# ========================================================
#  Virtual environments
# ========================================================
.venv/
venv/
env/
ENV/

# NOTE: ./lib is intentionally tracked in this repository.
# It holds the vendored `flowlauncher` package so the release zip
# works out of the box with Flow Launcher's embedded Python.
# Uncomment the line below only if you switch to runtime pip installs.
# /lib/

